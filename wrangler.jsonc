// Cloudflare Pages 配置
// - 网站本身是 dist/ 里的静态文件
// - /api/* 由 functions/ 处理（账号、大家分享的照片），数据存在 D1 数据库 christmas-tree
{
  "name": "christmas-tree",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-24",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "christmas-tree",
      "database_id": "130d9b8d-0b3f-4dc5-96ac-a636ea34ed36"
    }
  ],
  "vars": {
    // 允许跨域调用接口的网址：GitHub Pages 镜像 + 本地开发
    "CORS_ORIGINS": "https://jefferychen09.github.io,http://localhost:5173,http://127.0.0.1:5173"
  }
}
