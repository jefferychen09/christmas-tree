{
  "name": "christmas-tree",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-mediapipe.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-mediapipe.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:api": "npm run build && wrangler pages dev --port 8788",
    "types:worker": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply christmas-tree --local",
    "db:migrate": "wrangler d1 migrations apply christmas-tree --remote",
    "admin": "node scripts/make-admin.mjs",
    "deploy:cf": "npm run build && wrangler pages deploy dist --project-name christmas-tree --branch main --commit-dirty=true"
  },
  "dependencies": {
    "@fontsource/great-vibes": "^5.3.0",
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "@react-three/drei": "^9.117.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "maath": "^0.10.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "~5.6.2",
    "vite": "^5.4.11",
    "wrangler": "^4.168.0"
  }
}
